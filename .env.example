# AURA Environment Variables Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to git — it's in .gitignore

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key
LOG_LEVEL=DEBUG

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=aura_db

# ── Session ────────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECS=3600

# ── Rate Limiting (memory for dev, redis://... for prod) ───────────────────
RATELIMIT_STORAGE_URI=memory://

# ── Reverse Proxy (set true when behind nginx/caddy) ───────────────────────
PROXY_FIX_ENABLED=false

# ── CORS (comma-separated origins, leave blank for wildcard in dev) ────────
CORS_ORIGINS=

# ── AI API Keys ────────────────────────────────────────────────────────────
# Provider chain: Gemini → DeepSeek → Groq → OpenAI → local fallback
# At minimum, set ONE free key (Groq or DeepSeek) for live AI responses.

# Gemini (Google) — recommended primary; free tier at ai.google.dev
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# DeepSeek — free tier, excellent for study/reasoning tasks
# Get key: platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# Groq — free tier, ultra-fast Llama 3.3 70B
# Get key: console.groq.com → API Keys
GROQ_API_KEY=

# OpenAI — paid, last-resort fallback
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE

# ── SMS (Fast2SMS — for parent OTP) ────────────────────────────────────────
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=AURASM
SMS_ENABLED=false

# ── Email (optional) ──────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
