# =============================================================================
# AURA Environment Variables Template
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to git (it's in .gitignore)
#
# ENVIRONMENT HIERARCHY:
#   - .env.example    - This template with documented defaults (committed)
#   - .env            - Your local/deployed secrets (NOT committed)
#   - .env.production - Reference for production values (committed as template)
#
# For production deployment, use .env.production as a reference for
# recommended production settings, then create a .env with real values.
# =============================================================================

# =============================================================================
# FLASK CORE SETTINGS
# =============================================================================

# Environment mode: 'development' or 'production'
# Development enables debug mode and detailed error pages
FLASK_ENV=development

# Debug mode: enables auto-reload and detailed tracebacks
# Set to 'false' in production for security
FLASK_DEBUG=true

# Secret key for session signing and CSRF protection
# IMPORTANT: Generate a secure random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG for development, WARNING or ERROR for production
LOG_LEVEL=DEBUG

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Host binding: '0.0.0.0' allows external connections, '127.0.0.1' for local only
HOST=0.0.0.0

# Port number for the Flask server
PORT=5000

# =============================================================================
# DATABASE (MongoDB)
# =============================================================================

# MongoDB connection URI
# Local: mongodb://localhost:27017/
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/

# Database name within MongoDB
MONGODB_DB_NAME=aura_db

# Enable TLS/SSL for MongoDB connections (required for Atlas)
# Set to 'true' for production MongoDB Atlas connections
MONGODB_TLS=false

# =============================================================================
# SESSION & SECURITY
# =============================================================================

# Secure cookie flag: set to 'true' when serving over HTTPS
# IMPORTANT: Must be 'true' in production with HTTPS
SESSION_COOKIE_SECURE=false

# Session lifetime in seconds (default: 3600 = 1 hour)
SESSION_LIFETIME_SECS=3600

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate limit storage backend
# Development: memory://
# Production: redis://localhost:6379/0 or your Redis URL
# Using memory:// in production will not work across multiple workers
RATELIMIT_STORAGE_URI=memory://

# =============================================================================
# REVERSE PROXY (nginx, caddy, load balancer)
# =============================================================================

# Enable ProxyFix middleware when behind a reverse proxy
# Set to 'true' if using nginx, caddy, or cloud load balancers
PROXY_FIX_ENABLED=false

# Number of proxy layers for X-Forwarded-* headers (usually 1)
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Allowed origins for CORS (comma-separated)
# Leave blank for wildcard (*) in development
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

# =============================================================================
# AI API KEYS
# =============================================================================
# AURA uses a fallback chain: Gemini -> DeepSeek -> Groq -> OpenAI -> local
# You need at least ONE key configured for live AI responses.
# Free tier options: Gemini, DeepSeek, Groq

# Google Gemini (recommended primary) - Free tier available
# Get key: https://ai.google.dev/ -> Get API Key
GEMINI_API_KEY=

# DeepSeek - Free tier, excellent for study/reasoning tasks
# Get key: https://platform.deepseek.com/ -> API Keys
DEEPSEEK_API_KEY=

# Groq - Free tier, ultra-fast Llama 3.3 70B inference
# Get key: https://console.groq.com/ -> API Keys
GROQ_API_KEY=

# OpenAI - Paid, used as last-resort fallback
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use (if OpenAI is the active provider)
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# SMS SERVICE (Fast2SMS - for parent OTP verification)
# =============================================================================

# Fast2SMS API key for sending OTP to parents
# Get key: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Sender ID displayed on SMS (max 6 chars, approved by Fast2SMS)
FAST2SMS_SENDER_ID=AURASM

# Enable/disable SMS functionality
# Set to 'false' to skip SMS sending (useful for development)
SMS_ENABLED=false

# =============================================================================
# EMAIL SERVICE (Flask-Mail)
# =============================================================================

# SMTP server for sending alert emails
MAIL_SERVER=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
MAIL_PORT=587

# Email account username
# For Gmail, use your full email address
MAIL_USERNAME=

# Email account password
# For Gmail, use an App Password (not your regular password):
# https://support.google.com/accounts/answer/185833
MAIL_PASSWORD=

# Default sender address for outgoing emails
MAIL_DEFAULT_SENDER=

# =============================================================================
# UPLOAD LIMITS
# =============================================================================

# Maximum file upload size in bytes (default: 16 MB = 16777216)
MAX_CONTENT_LENGTH=16777216

# =============================================================================
# ERROR MONITORING (Optional)
# =============================================================================

# Sentry DSN for error tracking (optional, leave blank to disable)
# Get DSN: https://sentry.io/ -> Create Project -> Client Keys (DSN)
SENTRY_DSN=

# Sentry environment name (e.g., 'production', 'staging', 'development')
SENTRY_ENVIRONMENT=development

# =============================================================================
# DATA RETENTION (for cleanup.py script)
# =============================================================================

# Number of days to retain chat messages (default: 90)
DATA_RETENTION_CHAT_DAYS=90

# Number of days to retain stress/mood logs (default: 365)
DATA_RETENTION_LOGS_DAYS=365
