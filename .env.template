# AURA Environment Variables Template
# Copy this file to .env and fill in the values

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/aura_db

# Flask Configuration
SECRET_KEY=yoursecretkeyhere
FLASK_ENV=development
DEBUG=True

# SMS Service (Fast2SMS)
SMS_ENABLED=False
FAST2SMS_API_KEY=your_api_key_here

# Redis (for Rate Limiting)
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# AI Models (Transformers)
# Path to local model if not using Hugging Face Auto-download
GO_EMOTIONS_MODEL_PATH=SamLowe/roberta-base-go_emotions
